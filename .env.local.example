NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Cron — auto-sync Operations data every 6 hours (generate a random secret)
CRON_SECRET=

# Operations > Orders Metabase JSON feed (optional until Orders sync is enabled)
METABASE_OPERATIONS_ORDERS_URL=

# Operations Inventory + Procurement SKU search (shared Metabase question)
METABASE_INVENTORY_API_URL=https://zambeel.metabaseapp.com/public/question/316b4595-6180-43fe-b635-839b7f479c26.json

# Orders sync — trigger GitHub Actions workflow from portal Sync Data button
GITHUB_TOKEN=
GITHUB_REPO=wqrmhd177/-360-Services-Portal
# Optional: branch/ref for workflow_dispatch (default main)
# GITHUB_WORKFLOW_REF=main

# Password reset emails — Gmail (waqar@tazahtech.com)
PORTAL_NAME=360 Services Portal
GMAIL_USER=waqar@tazahtech.com
GMAIL_FROM=360 Services Portal <waqar@tazahtech.com>

# Option A — Google Workspace (@tazahtech.com): App Passwords are often blocked by admin.
# Use OAuth instead (run: npx tsx scripts/gmail-oauth-setup.ts after filling client id/secret below):
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Option B — Personal @gmail.com only: App Password works if 2-Step Verification is on
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Admin login (access all roles). Optional.
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=your-secure-admin-password
