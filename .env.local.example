NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Cron — auto-sync Operations data every 6 hours (generate a random secret)
CRON_SECRET=

# Operations > Orders Metabase JSON feed (optional until Orders sync is enabled)
METABASE_OPERATIONS_ORDERS_URL=

# Operations Inventory + Procurement SKU search (shared Metabase question)
METABASE_INVENTORY_API_URL=https://zambeel.metabaseapp.com/public/question/316b4595-6180-43fe-b635-839b7f479c26.json

# Orders sync — Sync Data dispatches .github/workflows/hourly-operations-sync.yml
# GITHUB_TOKEN = GitHub PAT (not a repo secret). Classic: scopes repo + workflow.
# Fine-grained: repository -360-Services-Portal, Actions Read and write, Contents Read.
# If 401 on dashboard Sync Data, regenerate the PAT and update Vercel, then redeploy.
# Omit GITHUB_TOKEN to run sync inside Vercel (needs METABASE_OPERATIONS_ORDERS_URL; may hit time limits).
GITHUB_TOKEN=
GITHUB_REPO=wqrmhd177/-360-Services-Portal
# Optional: branch/ref for workflow_dispatch (default main)
# GITHUB_WORKFLOW_REF=main

# Password reset emails — Gmail (waqar@tazahtech.com)
PORTAL_NAME=360 Services Portal
GMAIL_USER=waqar@tazahtech.com
GMAIL_FROM=360 Services Portal <waqar@tazahtech.com>

# Option A — Google Workspace (@tazahtech.com): App Passwords are often blocked by admin.
# Use OAuth instead (run: npx tsx scripts/gmail-oauth-setup.ts after filling client id/secret below):
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Option B — Personal @gmail.com only: App Password works if 2-Step Verification is on
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Product Pictures — Master Products Google Sheet (Sync Products button)
MASTER_PICKING_SHEET_ID=1iDFLFHbX7qcg2v0kLNmJGgNbqTpbWoodZ3gDkZChdr0

# Operations > Ticketing / OP Performance sheet sync (backend reads Google Sheets)
# Default ticketing workbook is built into the app; override if the sheet moves:
# TICKETING_SHEET_ID=
# TICKETING_RAW_GID=
# Optional: service account for private ops Google Sheets (recommended on Vercel)
# Share each sheet with the JSON "client_email" as Viewer. Enable "Google Sheets API" in GCP.
# Option 1 — minified JSON on ONE line (private_key must contain \n not real line breaks):
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
# Option 2 — base64 of the entire .json file (most reliable on Vercel):
# GOOGLE_SHEETS_SERVICE_ACCOUNT_BASE64=

# Admin login (access all roles). Optional.
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=your-secure-admin-password
